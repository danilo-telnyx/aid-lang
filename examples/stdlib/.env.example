# AID std.env Complete Example — Environment Configuration
# Copy this file to .env and customize for your environment.
#
# Required variables (app won't start without these):
PORT=3000
DATABASE_URL=sqlite://app.db

# Optional variables (sensible defaults used if not set):
APP_NAME=AID Env Demo
APP_ENV=development
API_KEY=your-api-key-here
LOG_LEVEL=info
MAX_WORKERS=4
CORS_ORIGIN=*
