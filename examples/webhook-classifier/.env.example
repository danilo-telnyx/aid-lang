# AID Webhook Classifier — Configuration
# Copy to .env and customize

# Server
PORT=8080

# Database
DATABASE_URL=sqlite://webhooks.db

# Authentication
JWT_SECRET=changeme-jwt-secret
WEBHOOK_API_KEY=whk_live_your_api_key_here

